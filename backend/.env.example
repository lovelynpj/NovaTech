# Copiá este archivo como ".env" (en esta misma carpeta, backend/) y completá
# con tus datos reales. NUNCA subas el archivo ".env" a GitHub (ya está en
# .gitignore) ni lo compartas en chats, capturas de pantalla, etc.

# --- Base de datos MySQL (los datos te los da Aiven cuando creás el servicio) ---
DB_HOST=tu-host.aivencloud.com
DB_PORT=00000
DB_USER=avnadmin
DB_PASSWORD=tu-password-de-aiven
DB_NAME=defaultdb
DB_SSL=true

# --- Cloudinary (para subir imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Seguridad del panel de administración ---
# JWT_SECRET: una clave larga y aleatoria, usala solo vos. Podés generarla en
# https://generate-secret.vercel.app/64
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria-de-64-caracteres

# --- Mercado Pago ---
# Se consiguen en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=tu-access-token-de-produccion

# --- URLs del frontend/backend ---
# En producción, poné acá la URL real de tu frontend en Vercel:
FRONTEND_URL=https://tu-frontend.vercel.app
# Para probar en tu computadora, comentá la de arriba y usá:
# FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=https://tu-backend.onrender.com

# --- Servidor ---
PORT=4000
